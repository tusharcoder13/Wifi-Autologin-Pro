<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allows cleartext HTTP communication which is mandatory for captive portal redirection and authentication -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
